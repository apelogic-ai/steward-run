{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["gha-runner-scale-set"],
  "properties": {
    "gha-runner-scale-set": {
      "type": "object",
      "additionalProperties": false,
      "required": ["githubConfigUrl", "githubConfigSecret", "controllerServiceAccount", "runnerScaleSetName", "scaleSetLabels", "minRunners", "maxRunners", "containerMode", "template"],
      "properties": {
        "githubConfigUrl": {"type": "string", "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)?$"},
        "githubConfigSecret": {"type": "string", "minLength": 1},
        "controllerServiceAccount": {
          "type": "object",
          "additionalProperties": false,
          "required": ["namespace", "name"],
          "properties": {
            "namespace": {"type": "string", "pattern": "^[a-z0-9](?:[-a-z0-9]*[a-z0-9])?$", "maxLength": 63},
            "name": {"type": "string", "pattern": "^[a-z0-9](?:[-a-z0-9]*[a-z0-9])?$", "maxLength": 63}
          }
        },
        "runnerScaleSetName": {"type": "string", "minLength": 1, "maxLength": 45},
        "scaleSetLabels": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "maxLength": 255}},
        "minRunners": {"const": 0},
        "maxRunners": {"type": "integer", "minimum": 1},
        "global": {"const": {}},
        "namespaceOverride": {"const": ""},
        "containerMode": {
          "type": "object", "required": ["type"],
          "additionalProperties": false,
          "properties": {"type": {"const": ""}}
        },
        "template": {
          "type": "object", "required": ["spec"],
          "additionalProperties": false,
          "properties": {
            "spec": {
              "type": "object",
              "additionalProperties": false,
              "required": ["automountServiceAccountToken", "securityContext", "imagePullSecrets", "containers"],
              "properties": {
                "automountServiceAccountToken": {"const": false},
                "securityContext": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["runAsNonRoot", "runAsUser", "runAsGroup", "fsGroup", "fsGroupChangePolicy", "seccompProfile"],
                  "properties": {
                    "runAsNonRoot": {"const": true},
                    "runAsUser": {"type": "integer", "minimum": 1},
                    "runAsGroup": {"type": "integer", "minimum": 1},
                    "fsGroup": {"type": "integer", "minimum": 1},
                    "fsGroupChangePolicy": {"const": "OnRootMismatch"},
                    "supplementalGroups": {
                      "type": "array",
                      "uniqueItems": true,
                      "items": {"type": "integer", "minimum": 1}
                    },
                    "seccompProfile": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["type"],
                      "properties": {"type": {"const": "RuntimeDefault"}}
                    }
                  }
                },
                "imagePullSecrets": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["name"],
                    "properties": {
                      "name": {"type": "string", "minLength": 1, "maxLength": 253, "pattern": "^[a-z0-9](?:[-a-z0-9]*[a-z0-9])?(?:\\.[a-z0-9](?:[-a-z0-9]*[a-z0-9])?)*$"}
                    }
                  }
                },
                "volumes": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["name", "configMap"],
                    "properties": {
                      "name": {"type": "string", "minLength": 1},
                      "configMap": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["name"],
                        "properties": {
                          "name": {
                            "type": "string",
                            "maxLength": 253,
                            "pattern": "^[a-z0-9](?:[-a-z0-9]*[a-z0-9])?(?:\\.[a-z0-9](?:[-a-z0-9]*[a-z0-9])?)*$"
                          },
                          "items": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "additionalProperties": false,
                              "required": ["key", "path"],
                              "properties": {
                                "key": {"type": "string", "minLength": 1, "maxLength": 253, "pattern": "^[A-Za-z0-9._-]+$"},
                                "path": {"type": "string", "minLength": 1}
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "containers": {
                  "type": "array", "minItems": 1, "maxItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["name", "image", "imagePullPolicy", "command", "securityContext", "resources"],
                    "properties": {
                      "name": {"const": "runner"},
                      "image": {
                        "type": "string",
                        "allOf": [
                          {"pattern": "^[^@\\s]+@sha256:[0-9a-f]{64}$"},
                          {"not": {"pattern": "^[^@\\s]+@sha256:0{64}$"}}
                        ]
                      },
                      "imagePullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]},
                      "command": {"const": ["/home/runner/run.sh"]},
                      "securityContext": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["allowPrivilegeEscalation", "capabilities", "privileged", "readOnlyRootFilesystem"],
                        "properties": {
                          "allowPrivilegeEscalation": {"const": false},
                          "runAsNonRoot": {"const": true},
                          "runAsUser": {"type": "integer", "minimum": 1},
                          "runAsGroup": {"type": "integer", "minimum": 1},
                          "capabilities": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": ["drop"],
                            "properties": {"drop": {"const": ["ALL"]}}
                          },
                          "privileged": {"const": false},
                          "readOnlyRootFilesystem": {"type": "boolean"}
                        }
                      },
                      "resources": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["requests", "limits"],
                        "properties": {
                          "requests": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": ["cpu", "memory"],
                            "properties": {
                              "cpu": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "number", "exclusiveMinimum": 0}]},
                              "memory": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "number", "exclusiveMinimum": 0}]}
                            }
                          },
                          "limits": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": ["cpu", "memory"],
                            "properties": {
                              "cpu": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "number", "exclusiveMinimum": 0}]},
                              "memory": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "number", "exclusiveMinimum": 0}]}
                            }
                          }
                        }
                      },
                      "env": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": ["name", "value"],
                          "properties": {
                            "name": {"type": "string", "minLength": 1},
                            "value": {"type": "string"}
                          }
                        }
                      },
                      "volumeMounts": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": ["name", "mountPath", "readOnly"],
                          "properties": {
                            "name": {"type": "string", "minLength": 1},
                            "mountPath": {"type": "string", "minLength": 1},
                            "readOnly": {"const": true}
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
