{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["gha-runner-scale-set"],
  "properties": {
    "gha-runner-scale-set": {
      "type": "object",
      "required": ["githubConfigUrl", "githubConfigSecret", "controllerServiceAccount", "runnerScaleSetName", "scaleSetLabels", "minRunners", "maxRunners", "containerMode", "template"],
      "properties": {
        "githubConfigUrl": {"type": "string", "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)?$"},
        "githubConfigSecret": {"type": "string", "minLength": 1},
        "controllerServiceAccount": {
          "type": "object",
          "additionalProperties": false,
          "required": ["namespace", "name"],
          "properties": {
            "namespace": {"type": "string", "pattern": "^[a-z0-9](?:[-a-z0-9]*[a-z0-9])?$", "maxLength": 63},
            "name": {"type": "string", "pattern": "^[a-z0-9](?:[-a-z0-9]*[a-z0-9])?$", "maxLength": 63}
          }
        },
        "runnerScaleSetName": {"type": "string", "minLength": 1, "maxLength": 45},
        "scaleSetLabels": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "maxLength": 255}},
        "minRunners": {"const": 0},
        "maxRunners": {"type": "integer", "minimum": 1},
        "containerMode": {
          "type": "object", "required": ["type"],
          "properties": {"type": {"const": ""}}
        },
        "template": {
          "type": "object", "required": ["spec"],
          "properties": {
            "spec": {
              "type": "object", "required": ["containers"],
              "properties": {
                "volumes": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {"type": "string", "minLength": 1},
                      "configMap": {
                        "type": "object",
                        "properties": {
                          "name": {
                            "type": "string",
                            "maxLength": 253,
                            "pattern": "^[a-z0-9](?:[-a-z0-9]*[a-z0-9])?(?:\\.[a-z0-9](?:[-a-z0-9]*[a-z0-9])?)*$"
                          },
                          "items": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "key": {"type": "string", "minLength": 1, "maxLength": 253, "pattern": "^[A-Za-z0-9._-]+$"},
                                "path": {"type": "string", "minLength": 1}
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "containers": {
                  "type": "array", "minItems": 1,
                  "items": {
                    "type": "object", "required": ["name", "image"],
                    "properties": {
                      "name": {"const": "runner"},
                      "image": {
                        "type": "string",
                        "allOf": [
                          {"pattern": "^[^@\\s]+@sha256:[0-9a-f]{64}$"},
                          {"not": {"pattern": "^[^@\\s]+@sha256:0{64}$"}}
                        ]
                      },
                      "env": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "name": {"type": "string", "minLength": 1},
                            "value": {"type": "string"}
                          }
                        }
                      },
                      "volumeMounts": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "name": {"type": "string", "minLength": 1},
                            "mountPath": {"type": "string", "minLength": 1},
                            "readOnly": {"type": "boolean"}
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
